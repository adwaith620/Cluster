# ==============================================================================
# Cluster - Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local or real secrets to git.

# Canonical public HTTPS URL for generating session join links & QR codes.
# In production on Vercel: https://cluster-tkm.vercel.app
# In local development: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://cluster-tkm.vercel.app"

# Supabase Public Configuration (accessible in client and server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_ or expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
